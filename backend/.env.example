# ── Backend environment configuration ─────────────────────────────────────────
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# Comma-separated list of allowed frontend origins.
# Development default: http://localhost:5173 (Vite dev server)
# Production: set to your actual deployed frontend origin.
CORS_ORIGINS=http://localhost:5173

# Application environment: development | production
ENVIRONMENT=development

# Optional: explicit path to the trained URL model artifact.
# Leave blank to use the default path (ml/artifacts/url_model.joblib).
# MODEL_PATH=
